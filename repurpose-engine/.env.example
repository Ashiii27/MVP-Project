# ---- required (Whisper transcription + default LLM) ----
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- optional: use Gemini for the writing steps instead of Llama ----
# GEMINI_API_KEY=AIza_xxxxxxxxxxxxxxxxxxxx
# LLM_PROVIDER=auto            # auto | groq | gemini

# ---- models ----
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# WHISPER_MODEL=whisper-large-v3

# ---- voice / output ----
# CREATOR_NAME=Your Name
# TONE=casual                  # casual | authoritative | irreverent | warm
# TOP_N=3
# MIN_IDEAS=5
# MAX_IDEAS=7
# LLM_TEMPERATURE=0.7
# KEEP_AUDIO=false
